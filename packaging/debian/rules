#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --bins

override_dh_auto_install:
	install -D -m755 target/release/tdm debian/tomos-display-manager/usr/bin/tdm
	install -D -m755 target/release/tdm-greeter debian/tomos-display-manager/usr/bin/tdm-greeter
	install -D -m644 README.md debian/tomos-display-manager/usr/share/doc/tomos-display-manager/README.md
	install -D -m644 packaging/greetd/config.toml.example debian/tomos-display-manager/usr/share/doc/tomos-display-manager/greetd-config.toml.example
