pkgname=tomos-display-manager
pkgver=0.0.6
pkgrel=1
pkgdesc="Lightweight Rust display manager and GTK4 greetd greeter"
arch=('x86_64' 'aarch64')
url="https://github.com/Spruhantom/Tomos-display-manager"
license=('MIT')
depends=('gtk4' 'glib2' 'glibc')
optdepends=('greetd: authentication broker and greeter launcher')
makedepends=('cargo' 'rust' 'pkgconf' 'git')
source=("git+https://github.com/Spruhantom/Tomos-display-manager.git#branch=main")
sha256sums=('SKIP')

build() {
  cd "$srcdir/Tomos-display-manager"
  cargo build --release --bins
}

package() {
  cd "$srcdir/Tomos-display-manager"
  install -Dm755 target/release/tdm "$pkgdir/usr/bin/tdm"
  install -Dm755 target/release/tdm-greeter "$pkgdir/usr/bin/tdm-greeter"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/greetd/config.toml.example "$pkgdir/usr/share/doc/$pkgname/greetd-config.toml.example"
  install -Dm644 packaging/tdm/greeter.conf.example "$pkgdir/usr/share/doc/$pkgname/greeter.conf.example"
  install -Dm644 docs/POWER-AND-THEMES.md "$pkgdir/usr/share/doc/$pkgname/POWER-AND-THEMES.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
